{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Monitor",
  "version": "0.1.0",
  "identifier": "com.loudowl.token-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Token Monitor",
        "url": "/",
        "width": 340,
        "height": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "details",
        "title": "Usage Details",
        "url": "/details",
        "width": 960,
        "height": 720,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Token Monitor Settings",
        "url": "/settings",
        "width": 580,
        "height": 680,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
